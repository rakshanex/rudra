---
import Base from "../layouts/Base.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { features } from "../data/features";

const verified = features.filter((f) => f.status === "VERIFIED");
const partial = features.filter((f) => f.status === "PARTIALLY VERIFIED");
const planned = features.filter((f) => f.status === "PLANNED" || f.status === "NOT VERIFIED");
---

<Base title="Roadmap" description="RUDRA development status: verified stable, partially verified, and planned capabilities." path="/roadmap">
  <section class="section">
    <div class="container" style="max-width:820px">
      <p class="eyebrow">Roadmap</p>
      <h1>Development status and roadmap</h1>
      <p class="lead">
        Every item carries an accurate status. This roadmap is descriptive of
        the current verified state, not a promise of dates.
      </p>

      <h2 style="margin-top:2rem">Verified and stable</h2>
      <div class="grid grid-2">
        {verified.map((f) => (
          <div class="card"><StatusBadge status={f.status} /><h3>{f.name}</h3><p style="font-size:0.9rem">{f.summary}</p></div>
        ))}
      </div>

      <h2 style="margin-top:2.2rem">Partially verified</h2>
      <div class="grid grid-2">
        {partial.map((f) => (
          <div class="card"><StatusBadge status={f.status} /><h3>{f.name}</h3><p style="font-size:0.9rem">{f.summary}</p></div>
        ))}
      </div>

      <h2 style="margin-top:2.2rem">Planned and not yet verified</h2>
      <div class="grid grid-2">
        {planned.map((f) => (
          <div class="card"><StatusBadge status={f.status} /><h3>{f.name}</h3><p style="font-size:0.9rem">{f.summary}</p></div>
        ))}
      </div>

      <div class="callout callout-info" style="margin-top:2rem">
        <h4>How items advance</h4>
        <p>An item moves to VERIFIED only after it is compiled, run and confirmed against a shipped release. See <a href="/transparency">Transparency</a> for the evidence behind each status.</p>
      </div>
    </div>
  </section>
</Base>
