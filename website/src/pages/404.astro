---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="The page you requested could not be found." path="/404">
  <section class="section">
    <div class="container" style="max-width:620px;text-align:center">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p class="lead" style="margin:1rem auto">The page you requested does not exist or has moved.</p>
      <div class="hero-actions" style="justify-content:center">
        <a class="btn btn-primary" href="/">Go home</a>
        <a class="btn btn-ghost" href="/docs/getting-started">Documentation</a>
      </div>
    </div>
  </section>
</Base>
