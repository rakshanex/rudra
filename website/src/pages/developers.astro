---
import Base from "../layouts/Base.astro";
import { githubRepo, githubIssues, githubDiscussions, releasesPage } from "../data/nav";
---

<Base title="Developer Hub" description="Resources for building with RUDRA: getting started, contribution guidance, GitHub integration and release information." path="/developers">
  <section class="section">
    <div class="container" style="max-width:820px">
      <p class="eyebrow">Developer Hub</p>
      <h1>Build with RUDRA</h1>
      <p class="lead">Everything you need to start building, reporting issues and following development.</p>

      <div class="grid grid-2" style="margin-top:1.8rem">
        <div class="card">
          <h3>Getting started</h3>
          <p>Install the toolchain and compile your first program.</p>
          <a class="btn btn-ghost" href="/docs/getting-started">Start here</a>
        </div>
        <div class="card">
          <h3>GitHub repository</h3>
          <p>Source distribution, releases and issue tracking.</p>
          <a class="btn btn-ghost" href={githubRepo} rel="noopener">Open repository</a>
        </div>
        <div class="card">
          <h3>Report an issue</h3>
          <p>File bugs and compatibility reports on the issue tracker.</p>
          <a class="btn btn-ghost" href={githubIssues} rel="noopener">Open issues</a>
        </div>
        <div class="card">
          <h3>Discuss and contribute</h3>
          <p>Feature requests, help and project showcases.</p>
          <a class="btn btn-ghost" href={githubDiscussions} rel="noopener">Open discussions</a>
        </div>
      </div>

      <h2 style="margin-top:2.5rem">Contributing</h2>
      <p>
        Contributions, bug reports and feature requests are welcome through the
        GitHub repository. Use Issues for defects and compatibility problems,
        and Discussions for proposals and questions. When reporting a problem,
        include your platform, the toolchain version from <code>rudra version</code>,
        and a minimal example that reproduces the behavior.
      </p>

      <h2 style="margin-top:2rem">Releases and versions</h2>
      <p>
        Release history and downloadable assets with checksums are published on
        the <a href="/downloads">Downloads</a> page and on the
        <a href={releasesPage} rel="noopener">GitHub releases</a> page.
      </p>

      <h2 style="margin-top:2rem">License</h2>
      <p>
        The RUDRA toolchain is distributed under the RUDRA License: the binaries
        are free to download and use, including for commercial software, while
        the compiler source remains proprietary. The programs you build are
        entirely yours. The full terms are in the repository LICENSE file.
      </p>

      <div class="callout callout-info" style="margin-top:1.5rem">
        <h4>Packages and libraries</h4>
        <p>
          A package directory is not published here. No third-party packages,
          projects or integrations are listed unless they are real and verified.
        </p>
      </div>

      <h2 style="margin-top:2rem">Contact</h2>
      <p>
        For direct support and inquiries, email
        <a href="mailto:support@rudralang.tech">support@rudralang.tech</a>. For
        public technical discussion, prefer GitHub Issues and Discussions so
        answers help the whole community.
      </p>
    </div>
  </section>
</Base>
