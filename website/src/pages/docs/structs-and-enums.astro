import Docs from "../../layouts/Docs.astro";
import CodeBlock from "../../components/CodeBlock.astro";
---

<Docs title="Structs and Enums" description="Grouping data with structs, and modeling choices with enums and match." slug="structs-and-enums">
  <p class="lead">RUDRA has structs for grouped data and enums for a fixed set of named values.</p>

  <h2>Structs</h2>
  <CodeBlock code={`struct Point { x: int, y: int }
fn main() {
    let p = Point { x: 3, y: 4 };
    print(p.x);
    print(p.y);
}`} />

  <h2>Enums</h2>
  <CodeBlock code={`enum Color { Red, Green, Blue }
fn name(c: Color) -> str {
    match c {
        Red => { return "red"; }
        Green => { return "green"; }
        Blue => { return "blue"; }
    }
}
fn main() {
    print(name(Green));
}`} />
  <p>This program prints <code>green</code>.</p>

  <div class="callout callout-info">
    <h4>Pattern matching</h4>
    <p>A <code>match</code> over an enum is checked for exhaustiveness: every variant must be handled, or a wildcard pattern must cover the rest.</p>
  </div>
</Docs>
