import Docs from "../../layouts/Docs.astro";
import CodeBlock from "../../components/CodeBlock.astro";
---

<Docs title="Modules and Projects" description="Create and run a RUDRA project with the driver." slug="modules">
  <p class="lead">The <code>rudra</code> driver scaffolds and runs projects.</p>

  <h2>Create a project</h2>
  <CodeBlock lang="sh" code={`rudra new myapp
cd myapp`} />
  <p>This creates a project with a manifest and an entry point:</p>
  <CodeBlock lang="toml" code={`[package]
name = "myapp"
version = "0.1.0"
edition = "2026"

[dependencies]`} />

  <h2>Entry point</h2>
  <p>The default entry point is <code>src/main.rux</code>:</p>
  <CodeBlock code={`fn main() {
    print("Hello, RUDRA!");
}`} />

  <h2>Run and build</h2>
  <CodeBlock lang="sh" code={`rudra run
rudra build
rudra check`} />
  <p><code>run</code> compiles and runs the default entry point, <code>build</code> produces a native binary, and <code>check</code> type-checks without building.</p>

  <div class="callout callout-info">
    <h4>Packages</h4>
    <p>The <code>ruxpkg</code> tool manages packages through a local registry. A public package directory is not published on this site.</p>
  </div>
</Docs>
