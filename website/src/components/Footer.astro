---
import { githubRepo, githubDiscussions, githubIssues, releasesPage } from "../data/nav";
const year = 2026;
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="nav-brand" style="margin-bottom:0.8rem">
          <img src="/rudra-phoenix.png" alt="RUDRA phoenix logo" width="30" height="30" />
          <span>RUDRA</span>
        </div>
        <p style="font-size:0.9rem;max-width:34ch">A compiled systems language with a native backend. Code, build, secure.</p>
      </div>
      <div>
        <h4>Product</h4>
        <a href="/ecosystem">Ecosystem</a>
        <a href="/downloads">Downloads</a>
        <a href="/roadmap">Roadmap</a>
        <a href="/transparency">Transparency</a>
      </div>
      <div>
        <h4>Developers</h4>
        <a href="/docs/getting-started">Documentation</a>
        <a href="/developers">Developer Hub</a>
        <a href={githubRepo} rel="noopener">GitHub Repository</a>
        <a href={githubIssues} rel="noopener">Report an Issue</a>
      </div>
      <div>
        <h4>Community</h4>
        <a href="/community">Community</a>
        <a href={githubDiscussions} rel="noopener">GitHub Discussions</a>
        <a href={releasesPage} rel="noopener">Releases</a>
        <a href="/rakshanex">RAKSHANEX Technologies</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>Copyright {year} Piyush Kumar / RAKSHANEX Technologies. All rights reserved.</span>
      <a href="/rakshanex" style="display:inline-flex;align-items:center;gap:0.5rem;color:var(--text-dim)">
        <img src="/rakshanex-logo.png" alt="RAKSHANEX Technologies logo" width="22" height="22" style="border-radius:5px" />
        <span>Powered by RAKSHANEX Technologies</span>
      </a>
    </div>
  </div>
</footer>
