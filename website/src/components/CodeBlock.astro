---
interface Props {
  code: string;
  lang?: string;
}
const { code, lang = "rux" } = Astro.props;
---
<div class="codeblock-wrap" style="position:relative">
  <button class="btn btn-ghost copy-btn" type="button" data-copy aria-label="Copy code"
    style="position:absolute;top:8px;right:8px;padding:0.3rem 0.7rem;font-size:0.78rem">Copy</button>
  <pre class="codeblock" data-lang={lang}><code>{code}</code></pre>
</div>

<script>
  document.querySelectorAll("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const pre = btn.parentElement?.querySelector("code");
      if (!pre) return;
      try {
        await navigator.clipboard.writeText(pre.textContent ?? "");
        const prev = btn.textContent;
        btn.textContent = "Copied";
        setTimeout(() => { btn.textContent = prev; }, 1400);
      } catch {
        btn.textContent = "Copy failed";
      }
    });
  });
</script>
