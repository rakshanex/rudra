fn page_status() -> str {
    let mut h: str = "<main id=\"main\"> <section class=\"section\"> <div class=\"container\"> <p class=\"eyebrow\">Status</p> <h1>Project and service status</h1> <p class=\"lead\">A snapshot of the RUDRA services and the current release, checked on 2026-11-06. This page is static and is not a live uptime monitor; it changes only when the site is rebuilt. Report problems on <a href=\"https://github.com/rakshanex/rudra/issues\" rel=\"noopener\">GitHub Issues</a>.</p>";
    h = h + " <h2 style=\"margin-top:2rem\">Services</h2> <table> <thead> <tr><th>Service</th><th>Address</th><th>Status</th><th>Implementation</th></tr> </thead> <tbody>";
    h = h + " <tr><td>Website</td><td><a href=\"/\">rudralang.tech</a></td><td><span class=\"badge badge-verified\">Operational</span></td><td>Static pages generated by a RUDRA program, no JavaScript</td></tr>";
    h = h + " <tr><td>Documentation</td><td><a href=\"/docs/getting-started/\">docs.rudralang.tech</a></td><td><span class=\"badge badge-verified\">Operational</span></td><td>Static pages generated by the same RUDRA program</td></tr>";
    h = h + " <tr><td>Downloads</td><td><a href=\"/downloads/\">download.rudralang.tech</a></td><td><span class=\"badge badge-verified\">Operational</span></td><td>Links to the release assets on GitHub</td></tr>";
    h = h + " <tr><td>Playground</td><td><a href=\"https://playground.rudralang.tech/\">playground.rudralang.tech</a></td><td><span class=\"badge badge-verified\">Operational</span></td><td>RUDRA server that compiles with ruxc 1.1.0 and runs code in a sandbox</td></tr>";
    h = h + " <tr><td>Package registry</td><td><a href=\"https://packages.rudralang.tech/\">packages.rudralang.tech</a></td><td><span class=\"badge badge-partial\">Preview</span></td><td>RUDRA server; few packages are published</td></tr>";
    h = h + " <tr><td>Benchmarks</td><td><a href=\"/benchmarks/\">benchmarks.rudralang.tech</a></td><td><span class=\"badge badge-verified\">Published</span></td><td>Measured results with method and caveats</td></tr>";
    h = h + " </tbody> </table>";
    h = h + " <h2 style=\"margin-top:2rem\">Current release</h2> <div class=\"callout callout-info\"> <h4>RUDRA 1.1.0 (self-hosted, Linux x86-64)</h4> <p>Archive <code>rudra-1.1.0-selfhost-linux-x86_64.tar.gz</code>, 242,197 bytes, SHA256 <code style=\"word-break:break-all\">13c31b6cadb74404812783e369fde08032dd671085c384c279e900073a7043b2</code>. Debian package <code>rudra-1.1.0-selfhost-amd64.deb</code>, 170,308 bytes, SHA256 <code style=\"word-break:break-all\">902a3ea0e95fa7bd85e7a153d235de648a09981f5d85d4f5fc3accb7147f88f6</code>. Both were downloaded and checked on 2026-11-06.</p> </div>";
    h = h + " <h2 style=\"margin-top:2rem\">Compiler test results</h2> <p>Measured on 2026-11-06 with the compiler from the development repository, which builds this website. The playground uses the released 1.1.0 compiler.</p> <table> <thead> <tr><th>Suite</th><th>Result</th></tr> </thead> <tbody>";
    h = h + " <tr><td>Language tests</td><td>84 of 84 compile and run</td></tr>";
    h = h + " <tr><td>Programs that must be rejected</td><td>19 of 19 rejected</td></tr>";
    h = h + " <tr><td>Code samples on this website</td><td>30 of 30 compile and run with the documented output</td></tr>";
    h = h + " <tr><td>Standard-library module tests</td><td>Not all pass; see <a href=\"/transparency/\">Transparency</a> for the scope of what is verified</td></tr>";
    h = h + " </tbody> </table> </div> </section> </main>";
    return h;
}
fn page_benchmarks() -> str {
    let mut h: str = "<main id=\"main\"> <section class=\"section\"> <div class=\"container\"> <p class=\"eyebrow\">Benchmarks</p> <h1>Measured performance</h1> <p class=\"lead\">Six small workloads, measured with the released RUDRA 1.1.0 compiler. Every workload prints its result, so the compiler cannot skip the work, and every result matches the C reference exactly. RUDRA programs are small and correct, but slower than optimised C.</p>";
    h = h + " <h2 style=\"margin-top:2rem\">Results</h2> <table> <thead> <tr><th>Workload</th><th>Result</th><th>RUDRA 1.1.0 (microseconds)</th><th>C reference, gcc -O2 (microseconds)</th><th>RUDRA / C</th><th>RUDRA binary</th></tr> </thead> <tbody>";
    h = h + " <tr><td>arith</td><td>0</td><td>32,599</td><td>17,847</td><td>1.8x</td><td>7,378 B</td></tr>";
    h = h + " <tr><td>branch</td><td>10,753,712</td><td>82,406</td><td>29,535</td><td>2.8x</td><td>7,897 B</td></tr>";
    h = h + " <tr><td>collect</td><td>0</td><td>81,722</td><td>9,162</td><td>8.9x</td><td>8,032 B</td></tr>";
    h = h + " <tr><td>recur</td><td>2,178,309</td><td>18,103</td><td>9,459</td><td>1.9x</td><td>7,192 B</td></tr>";
    h = h + " <tr><td>strproc</td><td>200,000</td><td>5,049</td><td>585</td><td>8.6x</td><td>7,942 B</td></tr>";
    h = h + " <tr><td>structs</td><td>650,000</td><td>3,337</td><td>809</td><td>4.1x</td><td>8,120 B</td></tr>";
    h = h + " </tbody> </table> <p style=\"font-size:0.9rem\">Lower times are faster. The C binaries were about 16 KB each.</p>";
    h = h + " <h2 style=\"margin-top:2rem\">Method</h2> <ul> <li>Machine: 11th Gen Intel Core i5-1135G7 at 2.40 GHz, Linux x86-64, run pinned to one CPU core.</li> <li>RUDRA: each program times itself with a monotonic clock and prints the median of 3 internal runs. The program was run 3 times and the middle value is shown. Measured on 2026-11-06 with <code>ruxc</code> from the 1.1.0 release.</li> <li>C: the same workloads compiled with gcc 13.3.0 at <code>-O2</code>, measured earlier on the same machine. The C sources were later removed from the repository, which is RUDRA-only, so the C numbers were not measured again and are recorded values.</li> <li>Because the two columns were measured at different times, treat the ratio as approximate.</li> </ul>";
    h = h + " <div class=\"callout callout-info\" style=\"margin-top:1.5rem\"> <h4>What these numbers do not show</h4> <p>These are small single-threaded loops, not real applications. RUDRA does not claim to be faster than C. Its measured strengths are small static binaries with no dependencies, exact results, and a compiler written in RUDRA.</p> </div> </div> </section> </main>";
    return h;
}
