import "fs";
import "layout";
import "routes";
import "style";
fn str_bb(s: str) -> int {
    let b: int = bb_new();
    let n: int = str_len(s);
    let mut i: int = 0;
    while i < n { bb_push(b, str_byte(s, i)); i = i + 1; }
    return b;
}
fn write_text(path: str, text: str) -> int {
    let mk: int = heap_mark();
    let r: int = fs_write_bytes(path, str_bb(text));
    heap_reset(mk);
    return r;
}
fn split(s: str, sep: int) -> list[str] {
    let out: list[str] = list_new();
    let n: int = str_len(s);
    let mut start: int = 0;
    let mut i: int = 0;
    while i <= n {
        let mut cut: int = 0;
        if i == n { cut = 1; } else { if str_byte(s, i) == sep { cut = 1; } }
        if cut == 1 {
            if i > start { push(out, substr(s, start, i - start)); }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}
fn out_file(out: str, path: str) -> str {
    if str_eq(path, "/404") { return fs_join(out, "404.html"); }
    if str_eq(path, "/") { return fs_join(out, "index.html"); }
    let dir: str = out + substr(path, 0, str_len(path) - 1);
    fs_mkdir_all(dir, 493);
    return fs_join(dir, "index.html");
}
fn main() -> int {
    let mut out: str = "dist";
    if arg_count() >= 2 { out = arg(1); }
    let mut assets: str = "assets";
    if arg_count() >= 3 { assets = arg(2); }
    fs_mkdir_all(out, 493);
    let lines: list[str] = split(route_table(), 10);
    let mut written: int = 0;
    let mut i: int = 0;
    while i < list_len(lines) {
        let mk: int = heap_mark();
        let f: list[str] = split(get(lines, i), 9);
        let path: str = get(f, 0);
        let html: str = page_html(path, get(f, 1), get(f, 2), route_body(i));
        if write_text(out_file(out, path), html) > 0 { written = written + 1; }
        heap_reset(mk);
        i = i + 1;
    }
    let mut items: str = "";
    let mut sitemap: str = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n";
    i = 0;
    while i < list_len(lines) {
        let f2: list[str] = split(get(lines, i), 9);
        let p: str = get(f2, 0);
        if str_eq(p, "/404") == false {
            items = items + search_item(p, get(f2, 1), get(f2, 2));
            sitemap = sitemap + "<url><loc>" + site_origin() + p + "</loc></url>\n";
        }
        i = i + 1;
    }
    sitemap = sitemap + "<url><loc>" + site_origin() + "/search/</loc></url>\n</urlset>\n";
    fs_mkdir_all(fs_join(out, "search"), 493);
    if write_text(fs_join(out, "search/index.html"), page_html("/search/", "Search - RUDRA", "Every page on the RUDRA website with a short description.", search_page(items))) > 0 { written = written + 1; }
    write_text(fs_join(out, "style.css"), site_css());
    write_text(fs_join(out, "sitemap.xml"), sitemap);
    write_text(fs_join(out, "robots.txt"), "User-agent: *\nAllow: /\n\nSitemap: https://rudralang.tech/sitemap.xml\n");
    write_text(fs_join(out, "CNAME"), "rudralang.tech\n");
    write_text(fs_join(out, "_headers"), "/*\n  X-Content-Type-Options: nosniff\n  Referrer-Policy: strict-origin-when-cross-origin\n  X-Frame-Options: DENY\n  Content-Security-Policy: default-src 'self'; script-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'\n");
    write_text(fs_join(out, "googlede6070be797f73c9.html"), "google-site-verification: googlede6070be797f73c9.html");
    let copied: int = fs_copy_suffix(assets, out, ".png") + fs_copy_suffix(assets, out, ".webp");
    print("pages " + to_str(written) + " assets " + to_str(copied) + " output " + out + "\n");
    return 0;
}
return main();
