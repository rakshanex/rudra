fn site_css() -> str {
    return ":root{--bg: #060810;--bg-elev: #0b0f1c;--bg-card: #0e1424;--bg-card-hi: #121a2e;--border: #1a2338;--border-strong: #273350;--text: #eef2fb;--text-dim: #a4b2cd;--text-faint: #68769440;--text-muted: #6b7a99;--blue: #3bd0ff;--blue-deep: #2e7bff;--cyan: #67f0e0;--amber: #ff7a33;--gold: #f0b65c;--ok: #43d98a;--warn: #f0b65c;--plan: #7ea6ff;--off: #8291ab;--maxw: 100%;--radius: 16px;--radius-sm: 9px;--font: ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, Inter, Helvetica, Arial, sans-serif;--mono: ui-monospace, \"SF Mono\", \"JetBrains Mono\", Menlo, Consolas, monospace;--shadow: 0 20px 50px -24px rgba(0, 0, 0, .7);--ease: cubic-bezier(.22, 1, .36, 1)}*{box-sizing:border-box}html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}body{margin:0;background:var(--bg);color:var(--text);font-family:var(--font);line-height:1.65;font-size:16px;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}body:before{content:\"\";position:fixed;inset:0;z-index:-1;background:radial-gradient(1000px 540px at 82% -10%,rgba(46,123,255,.12),transparent 62%),radial-gradient(760px 440px at 10% 2%,rgba(255,122,51,.055),transparent 58%)}a{color:var(--blue);text-decoration:none}a:hover{color:#7ee0ff}h1,h2,h3,h4{line-height:1.12;letter-spacing:-.02em;font-weight:720;color:#f6f9ff;margin:0 0 .5rem}h1{font-size:clamp(2.3rem,5.2vw,3.75rem);letter-spacing:-.03em}h2{font-size:clamp(1.65rem,3.2vw,2.35rem)}h3{font-size:1.22rem}p{color:var(--text-dim);margin:0 0 1rem}.container{max-width:var(--maxw);width:100%;margin:0;padding:0 clamp(1rem,2.5vw,2.5rem)}.container-wide{max-width:100%;width:100%;margin:0;padding:0 clamp(1rem,2.5vw,2.5rem)}.section{padding:5rem 0}.section-tight{padding:3rem 0}.narrow{max-width:none}.eyebrow{display:inline-flex;align-items:center;gap:.5rem;text-transform:uppercase;letter-spacing:.16em;font-size:.74rem;color:var(--blue);font-weight:650;margin-bottom:.7rem}.eyebrow:before{content:\"\";width:18px;height:1px;background:var(--blue);opacity:.6}.lead{font-size:1.16rem;color:var(--text-dim);max-width:none}.grid{display:grid;gap:1.15rem}.grid-2{grid-template-columns:repeat(2,1fr)}.grid-3{grid-template-columns:repeat(3,1fr)}.grid-4{grid-template-columns:repeat(4,1fr)}.card{background:linear-gradient(180deg,var(--bg-card-hi),var(--bg-card));border:1px solid var(--border);border-radius:var(--radius);padding:1.6rem;transition:border-color .25s var(--ease),transform .25s var(--ease)}.card:hover{border-color:var(--border-strong);transform:translateY(-3px)}.card h3{margin:.5rem 0}.card-icon{width:40px;height:40px;border-radius:10px;display:grid;place-items:center;margin-bottom:.4rem;background:linear-gradient(135deg,#2e7bff2e,#3bd0ff1a);border:1px solid var(--border-strong);color:var(--blue)}.card-icon svg{width:20px;height:20px}.btn{display:inline-flex;align-items:center;gap:.5rem;padding:.78rem 1.4rem;border-radius:11px;font-weight:630;font-size:.96rem;border:1px solid transparent;cursor:pointer;transition:transform .16s var(--ease),box-shadow .25s var(--ease),background .2s}.btn:hover{transform:translateY(-1px);color:inherit}.btn svg{width:17px;height:17px}.btn-primary{background:linear-gradient(135deg,var(--blue-deep),var(--blue));color:#05101f;box-shadow:0 8px 24px -10px #2e7bff99}.btn-primary:hover{box-shadow:0 10px 30px -10px #2e7bffcc;color:#05101f}.btn-ghost{border-color:var(--border-strong);color:var(--text);background:#ffffff05}.btn-ghost:hover{border-color:var(--blue);color:#fff}.btn-lg{padding:.95rem 1.7rem;font-size:1.02rem}.badge{display:inline-flex;align-items:center;gap:.4rem;font-size:.7rem;font-weight:720;letter-spacing:.05em;padding:.24rem .62rem;border-radius:999px;border:1px solid var(--border-strong);text-transform:uppercase}.badge:before{content:\"\";width:6px;height:6px;border-radius:50%;background:currentColor}.badge-verified{color:var(--ok);border-color:#43d98a66;background:#43d98a0f}.badge-partial{color:var(--warn);border-color:#f0b65c66;background:#f0b65c0f}.badge-planned{color:var(--plan);border-color:#7ea6ff66;background:#7ea6ff0f}.badge-off{color:var(--off);border-color:#8291ab66}.site-header{position:sticky;top:0;z-index:50;background:#060810c7;backdrop-filter:blur(14px) saturate(140%);border-bottom:1px solid var(--border)}.nav{display:flex;align-items:center;justify-content:space-between;height:66px;gap:1rem}.nav-brand{display:flex;align-items:center;gap:.6rem;font-weight:740;font-size:1.06rem;color:#fff;letter-spacing:-.01em}.nav-brand img{width:32px;height:32px}.footer .nav-brand{color:var(--text)}.nav-links{display:flex;gap:1.3rem;align-items:center}.nav-links a{color:var(--text-dim);font-size:.92rem;font-weight:520;transition:color .18s}.nav-links a:hover{color:#fff}.nav-cta{display:flex;gap:.6rem;align-items:center}.nav-toggle{display:none;background:none;border:1px solid var(--border-strong);border-radius:9px;color:var(--text);padding:.45rem .7rem;cursor:pointer;font-size:.85rem}.hero{padding:5.5rem 0 4rem;position:relative}.hero-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:3rem;align-items:center}.hero h1{max-width:15ch}.hero .lead{margin:1.2rem 0 2rem;font-size:1.22rem}.hero-actions{display:flex;gap:.85rem;flex-wrap:wrap}.hero-meta{margin-top:1.8rem;display:flex;gap:1.6rem;flex-wrap:wrap;color:var(--text-muted);font-size:.86rem}.hero-meta strong{color:var(--text);font-weight:650}.hero-visual{display:flex;justify-content:center}.terminal{width:100%;max-width:460px;background:#080b14;border:1px solid var(--border-strong);border-radius:14px;overflow:hidden;box-shadow:var(--shadow);font-family:var(--mono);font-size:.84rem}.terminal-bar{display:flex;align-items:center;gap:.4rem;padding:.7rem .9rem;background:#0c101c;border-bottom:1px solid var(--border)}.terminal-dot{width:11px;height:11px;border-radius:50%}.terminal-title{margin-left:.6rem;color:var(--text-muted);font-size:.78rem}.terminal-body{padding:1.1rem 1.2rem;line-height:1.75}.terminal-body .t-prompt{color:var(--blue)}.terminal-body .t-cmd{color:#eaf0fb}.terminal-body .t-ok{color:var(--ok)}.terminal-body .t-dim{color:var(--text-muted)}.terminal-body .t-key{color:var(--blue)}.terminal-body .t-str{color:var(--gold)}.logo-strip{display:flex;align-items:center;gap:1.4rem;flex-wrap:wrap;color:var(--text-muted);font-size:.82rem}.footer{border-top:1px solid var(--border);padding:3.5rem 0 2.5rem;margin-top:2rem;color:var(--text-muted)}.footer-grid{display:grid;grid-template-columns:1.5fr repeat(4,1fr);gap:2rem}.footer a{color:var(--text-dim);display:block;margin:.38rem 0;font-size:.9rem}.footer a:hover{color:#fff}.footer h4{color:var(--text);font-size:.78rem;text-transform:uppercase;letter-spacing:.12em;margin:0 0 .7rem}.footer-bottom{margin-top:2.5rem;padding-top:1.6rem;border-top:1px solid var(--border);display:flex;justify-content:space-between;flex-wrap:wrap;gap:.6rem;font-size:.84rem;align-items:center}code,pre{font-family:var(--mono)}.codeblock{background:#05080f;border:1px solid var(--border);border-radius:11px;padding:1.05rem 1.2rem;overflow-x:auto;font-size:.875rem;color:#d6e2f5;margin:0;line-height:1.7}p code,li code,td code{background:var(--bg-elev);border:1px solid var(--border);border-radius:5px;padding:.08rem .4rem;font-size:.86em;color:var(--blue)}table{width:100%;border-collapse:collapse;margin:1rem 0;font-size:.92rem}th,td{text-align:left;padding:.75rem .85rem;border-bottom:1px solid var(--border)}th{color:var(--text);font-weight:640;font-size:.82rem;text-transform:uppercase;letter-spacing:.04em}td{color:var(--text-dim)}.callout{border:1px solid var(--border-strong);border-left-width:3px;border-radius:11px;padding:1.05rem 1.2rem;margin:1.3rem 0;background:var(--bg-elev)}.callout-info{border-left-color:var(--blue)}.callout-warn{border-left-color:var(--warn)}.callout h4{margin:0 0 .3rem;font-size:.95rem}.callout p{margin:0;font-size:.92rem}.section-head{text-align:center;max-width:none;margin:0 auto 2.6rem}.section-head .lead{margin:0 auto}.stat-row{display:grid;grid-template-columns:repeat(4,1fr);gap:1.1rem}.stat{border:1px solid var(--border);border-radius:13px;padding:1.3rem;background:var(--bg-card)}.stat b{display:block;font-size:1.5rem;color:#fff;letter-spacing:-.02em}.stat span{font-size:.85rem;color:var(--text-muted)}.docs-layout{display:grid;grid-template-columns:250px 1fr;gap:2.8rem;align-items:start}.docs-side{position:sticky;top:86px;border-right:1px solid var(--border);padding-right:1.1rem;max-height:calc(100vh - 100px);overflow-y:auto}.docs-side h4{font-size:.74rem;text-transform:uppercase;letter-spacing:.1em;color:var(--text-muted);margin:1.3rem 0 .5rem}.docs-side a{display:block;color:var(--text-dim);padding:.34rem 0;font-size:.9rem;border-radius:6px}.docs-side a:hover{color:#fff}.docs-side a.active{color:var(--blue);font-weight:640}.docs-main{min-width:0;max-width:none}.docs-main h1{margin-top:0}.docs-nav-fb{display:flex;justify-content:space-between;margin-top:3rem;padding-top:1.6rem;border-top:1px solid var(--border);gap:1rem;flex-wrap:wrap}:focus-visible{outline:2px solid var(--blue);outline-offset:3px;border-radius:4px}.skip-link{position:absolute;left:-999px;top:0;background:var(--blue);color:#05101f;padding:.6rem 1.1rem;border-radius:0 0 9px;z-index:100;font-weight:600}.skip-link:focus{left:0}@media (max-width: 960px){.hero-grid{grid-template-columns:1fr;gap:2.4rem}.hero-visual{order:-1}.footer-grid{grid-template-columns:1fr 1fr}.stat-row,.grid-3,.grid-4{grid-template-columns:repeat(2,1fr)}.docs-layout{grid-template-columns:1fr}.docs-side{position:static;border-right:none;border-bottom:1px solid var(--border);padding-bottom:1rem;max-height:none}.nav{flex-wrap:wrap;height:auto;padding:.6rem 0}.nav-links{display:flex;flex-wrap:wrap;gap:.5rem 1rem;order:3;width:100%}.nav-cta .btn-ghost{display:none}.nav[data-open=true] .nav-links{display:flex;position:absolute;top:66px;left:0;right:0;flex-direction:column;background:var(--bg-elev);border-bottom:1px solid var(--border);padding:1.1rem 1.4rem;gap:1rem}}@media (max-width: 600px){.grid-2,.grid-3,.grid-4,.footer-grid{grid-template-columns:1fr}.section{padding:3.4rem 0}.stat-row{grid-template-columns:1fr 1fr}}@media (prefers-reduced-motion: reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}.icon-btn{display:grid;place-items:center;width:38px;height:38px;border:1px solid var(--border-strong);border-radius:10px;background:#ffffff05;color:var(--text-dim);cursor:pointer;transition:color .18s,border-color .18s}.icon-btn:hover{color:#fff;border-color:var(--blue)}.icon-btn svg{width:18px;height:18px}.icon-moon{display:none}.search-modal{position:fixed;inset:0;z-index:100;display:flex;align-items:flex-start;justify-content:center;padding-top:12vh}.search-modal[hidden]{display:none!important}.search-backdrop{position:absolute;inset:0;background:#02040a99;backdrop-filter:blur(3px)}.search-panel{position:relative;width:min(600px,92vw);background:var(--bg-elev);border:1px solid var(--border-strong);border-radius:14px;box-shadow:var(--shadow);overflow:hidden}.search-input{width:100%;border:none;background:transparent;color:var(--text);font-size:1.05rem;padding:1.1rem 1.3rem;outline:none;border-bottom:1px solid var(--border)}.search-results{list-style:none;margin:0;padding:.4rem;max-height:56vh;overflow-y:auto}.search-results li a{display:block;padding:.7rem .9rem;border-radius:9px;color:var(--text)}.search-results li a:hover,.search-results li a:focus{background:var(--bg-card-hi)}.search-results li strong{display:block;font-size:.96rem}.search-results li span{display:block;font-size:.83rem;color:var(--text-muted);margin-top:.15rem}.search-empty{padding:1rem 1.1rem;color:var(--text-muted);font-size:.9rem}.search-hint{padding:.6rem 1.3rem;font-size:.78rem;color:var(--text-muted);border-top:1px solid var(--border)}.breadcrumb{font-size:.82rem;color:var(--text-muted);margin-bottom:1rem}.breadcrumb a{color:var(--text-dim)}.read-progress{position:fixed;top:0;left:0;height:2px;background:linear-gradient(90deg,var(--blue-deep),var(--blue));z-index:60;width:0}.playground-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.pg-editor,.pg-output{background:#05080f;border:1px solid var(--border);border-radius:12px;overflow:hidden}.pg-head{display:flex;align-items:center;justify-content:space-between;padding:.55rem .9rem;background:#0b0f1c;border-bottom:1px solid var(--border);font-size:.82rem;color:var(--text-muted)}.pg-code{margin:0;padding:1rem 1.1rem;font-family:var(--mono);font-size:.86rem;color:#d6e2f5;min-height:260px;white-space:pre;overflow-x:auto}.pg-sample-row{display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:1rem}.pg-sample{padding:.4rem .8rem;border:1px solid var(--border-strong);border-radius:8px;background:transparent;color:var(--text-dim);cursor:pointer;font-size:.85rem}.pg-sample:hover,.pg-sample[aria-pressed=true]{border-color:var(--blue);color:#fff}@media (max-width: 760px){.playground-grid{grid-template-columns:1fr}}\n";
}
