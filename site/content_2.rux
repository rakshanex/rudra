fn page_ecosystem_ai_integration() -> str {
    return "<main id=\"main\">  <section class=\"section\"> <div class=\"container\"> <p class=\"eyebrow\">Ecosystem component</p> <div style=\"display:flex;align-items:center;gap:0.8rem;flex-wrap:wrap\"> <h1 style=\"margin:0\">AI Integration</h1> <span class=\"badge badge-planned\">PLANNED</span> </div> <p class=\"lead\" style=\"margin-top:0.8rem\">Planned tooling for AI-assisted development.</p> <p style=\"margin-top:1.5rem\">AI integration is a planned direction for the RUDRA ecosystem: assistance for writing, explaining and reviewing RUDRA code, surfaced through editor tooling. No AI-integration capability ships in the released 1.1.0 toolchain, so it is marked as planned rather than available.</p> <h2 style=\"margin-top:2rem\">Details</h2> <ul> <li>Intended: code assistance, explanation and review for RUDRA sources.</li><li>Intended delivery: through editor tooling such as the language server (which is in the source repository, not yet released), never as a required runtime dependency.</li><li>No AI-integration feature is present in the released 1.1.0 binaries.</li><li>Any future capability will be published with an accurate status and evidence on the Transparency page.</li> </ul> <div class=\"callout callout-warn\" style=\"margin-top:1.5rem\"> <h4>Note</h4> <p>Roadmap item. This site does not claim any AI capability is available, and no external AI service is embedded in the website.</p> </div> <p style=\"margin-top:2rem\"><a href=\"/ecosystem\">Back to all components</a> &middot; <a href=\"/transparency\">Verification evidence</a></p> </div> </section>  </main>";
}
fn page_ecosystem_compiler() -> str {
    return "<main id=\"main\">  <section class=\"section\"> <div class=\"container\"> <p class=\"eyebrow\">Ecosystem component</p> <div style=\"display:flex;align-items:center;gap:0.8rem;flex-wrap:wrap\"> <h1 style=\"margin:0\">Compiler</h1> <span class=\"badge badge-verified\">VERIFIED</span> </div> <p class=\"lead\" style=\"margin-top:0.8rem\">Source to native binary, directly.</p> <p style=\"margin-top:1.5rem\">The ruxc compiler turns a .rux source file into a native x86-64 Linux ELF executable. The compiler is itself written in RUDRA, and the released 1.1.0 ruxc is a statically linked ELF with zero runtime dependencies.</p> <h2 style=\"margin-top:2rem\">Details</h2> <ul> <li><code>ruxc &lt;file.rux&gt; &lt;output&gt;</code> compiles a source file to a native executable; run it with <code>./output</code>.</li><li><code>rudra &lt;file.rux&gt; &lt;output&gt;</code> is a small shell wrapper that copies the standard library next to your source in a temporary directory and then runs ruxc. Use it for programs that import standard-library modules.</li><li>With plain <code>ruxc</code>, an <code>import</code> only resolves modules located in the same directory as the source file.</li><li>There is no <code>--run</code> or <code>-o</code> flag in the released 1.1.0 toolchain: compile, then run the output yourself.</li><li>Target: Linux x86-64 only.</li> </ul> <div class=\"callout callout-warn\" style=\"margin-top:1.5rem\"> <h4>Scope</h4> <p>The released 1.1.0 toolchain consists of ruxc and the rudra wrapper. The newer driver (rudra build / run / check) is in the source repository and not yet released.</p> </div> <p style=\"margin-top:2rem\"><a href=\"/ecosystem\">Back to all components</a> &middot; <a href=\"/transparency\">Verification evidence</a></p> </div> </section>  </main>";
}
fn page_ecosystem() -> str {
    return "<main id=\"main\">  <section class=\"section\"> <div class=\"container\"> <p class=\"eyebrow\">Ecosystem</p> <h1>The RUDRA ecosystem</h1> <p class=\"lead\">\nEight components, each presented independently with an accurate status.\n        Statuses reflect what has been verified against the shipped release.\n</p> <div class=\"grid grid-2\" style=\"margin-top:2rem\"> <a class=\"card\" href=\"/ecosystem/language\" style=\"display:block\"> <span class=\"badge badge-verified\">VERIFIED</span> <h3>RUDRA Language</h3> <p style=\"font-size:0.93rem\">A compiled systems language with an easy, readable syntax.</p> </a><a class=\"card\" href=\"/ecosystem/compiler\" style=\"display:block\"> <span class=\"badge badge-verified\">VERIFIED</span> <h3>Compiler</h3> <p style=\"font-size:0.93rem\">Source to native binary, directly.</p> </a><a class=\"card\" href=\"/ecosystem/runtime\" style=\"display:block\"> <span class=\"badge badge-partial\">PARTIALLY VERIFIED</span> <h3>Runtime</h3> <p style=\"font-size:0.93rem\">A minimal native execution model.</p> </a><a class=\"card\" href=\"/ecosystem/standard-library\" style=\"display:block\"> <span class=\"badge badge-partial\">PARTIALLY VERIFIED</span> <h3>Standard Library</h3> <p style=\"font-size:0.93rem\">Standard-library modules for everyday systems work.</p> </a><a class=\"card\" href=\"/ecosystem/ruxel-studio\" style=\"display:block\"> <span class=\"badge badge-off\">NOT VERIFIED</span> <h3>Ruxel Studio</h3> <p style=\"font-size:0.93rem\">A terminal IDE for RUDRA (source repository).</p> </a><a class=\"card\" href=\"/ecosystem/toolchain\" style=\"display:block\"> <span class=\"badge badge-partial\">PARTIALLY VERIFIED</span> <h3>Developer Toolchain</h3> <p style=\"font-size:0.93rem\">Compiler and wrapper released; more tools in the source repository.</p> </a><a class=\"card\" href=\"/ecosystem/ai-integration\" style=\"display:block\"> <span class=\"badge badge-planned\">PLANNED</span> <h3>AI Integration</h3> <p style=\"font-size:0.93rem\">Planned tooling for AI-assisted development.</p> </a><a class=\"card\" href=\"/ecosystem/security\" style=\"display:block\"> <span class=\"badge badge-partial\">PARTIALLY VERIFIED</span> <h3>Security Capabilities</h3> <p style=\"font-size:0.93rem\">Memory-safety oriented language design.</p> </a> </div> </div> </section>  </main>";
}
fn page_ecosystem_language() -> str {
    return "<main id=\"main\">  <section class=\"section\"> <div class=\"container\"> <p class=\"eyebrow\">Ecosystem component</p> <div style=\"display:flex;align-items:center;gap:0.8rem;flex-wrap:wrap\"> <h1 style=\"margin:0\">RUDRA Language</h1> <span class=\"badge badge-verified\">VERIFIED</span> </div> <p class=\"lead\" style=\"margin-top:0.8rem\">A compiled systems language with an easy, readable syntax.</p> <p style=\"margin-top:1.5rem\">RUDRA is a statically typed, compiled programming language. Programs are written in .rux source files and compiled to native executables by the self-hosted ruxc compiler. A program runs its top-level statements; the usual entry point is <code>return main();</code> at the end of the file, and the exit status is the value main returns.</p> <h2 style=\"margin-top:2rem\">Details</h2> <ul> <li>Functions with typed parameters and return types, including recursion.</li><li>let and let mut bindings and assignment.</li><li>if / else if / else, while, <code>for i in 0..n</code> (half-open range), <code>for v in list</code>, break and continue.</li><li>Types: int (64-bit), float, bool, str and list[int].</li><li>Structs and enums (unit and payload variants, written <code>Shape.Circle(5)</code>) with match and exhaustiveness checking.</li><li>Not implemented: traits, closures, tuples, fixed-size arrays and hex or binary literals. Generics syntax is accepted but erased, not specialized.</li> </ul> <div class=\"callout callout-warn\" style=\"margin-top:1.5rem\"> <h4>Note</h4> <p>This describes the self-hosted ruxc compiler in the released 1.1.0 toolchain. See the Transparency page for the exact verified surface.</p> </div> <p style=\"margin-top:2rem\"><a href=\"/ecosystem\">Back to all components</a> &middot; <a href=\"/transparency\">Verification evidence</a></p> </div> </section>  </main>";
}
fn page_ecosystem_runtime() -> str {
    return "<main id=\"main\">  <section class=\"section\"> <div class=\"container\"> <p class=\"eyebrow\">Ecosystem component</p> <div style=\"display:flex;align-items:center;gap:0.8rem;flex-wrap:wrap\"> <h1 style=\"margin:0\">Runtime</h1> <span class=\"badge badge-partial\">PARTIALLY VERIFIED</span> </div> <p class=\"lead\" style=\"margin-top:0.8rem\">A minimal native execution model.</p> <p style=\"margin-top:1.5rem\">RUDRA programs are static native executables with no runtime, interpreter or virtual machine. There are no spawn, mutex or channel builtins in the self-hosted compiler; concurrency primitives are provided by standard-library modules instead.</p> <h2 style=\"margin-top:2rem\">Details</h2> <ul> <li>Safety checks are compiled in: integer division by zero traps, list access is bounds-checked, and lists are capped at 512 elements.</li><li><code>std/thread.rux</code> provides process-based concurrency (thread_fork, thread_wait, thread_exit) built on the fork system call; these are processes, not shared-memory threads.</li><li><code>std/chan.rux</code> provides channels (chan_new, chan_send_status, chan_recv_status and try / timeout variants) carrying 64-bit integers in FIFO order over an operating-system pipe, with a finite capacity (about 64 KB by default).</li><li>There is no mutex module in the released standard library.</li> </ul> <div class=\"callout callout-warn\" style=\"margin-top:1.5rem\"> <h4>Note</h4> <p>Threads, mutexes and channels as language builtins (spawn, mutex_new, chan_send) belong to the earlier Rust-based 1.0.x toolchain and do not exist in the self-hosted 1.1.0 compiler.</p> </div> <p style=\"margin-top:2rem\"><a href=\"/ecosystem\">Back to all components</a> &middot; <a href=\"/transparency\">Verification evidence</a></p> </div> </section>  </main>";
}
fn page_ecosystem_ruxel_studio() -> str {
    return "<main id=\"main\">  <section class=\"section\"> <div class=\"container\"> <p class=\"eyebrow\">Ecosystem component</p> <div style=\"display:flex;align-items:center;gap:0.8rem;flex-wrap:wrap\"> <h1 style=\"margin:0\">Ruxel Studio</h1> <span class=\"badge badge-off\">NOT VERIFIED</span> </div> <p class=\"lead\" style=\"margin-top:0.8rem\">A terminal IDE for RUDRA.</p> <p style=\"margin-top:1.5rem\">Ruxel Studio is a full-screen terminal (TUI) development environment written in RUDRA. It lives in the source repository (ruxel-studio/studio.rux) and is not part of the released 1.1.0 archive, so this site makes no claim that a released build is available today. It is a terminal application, not a graphical IDE.</p> <h2 style=\"margin-top:2rem\">Details</h2> <ul> <li>In the source repository: an editor with line numbers, plus build, run and test commands driven from the keyboard.</li><li>Not included in the 1.1.0 release archive; no downloadable build exists.</li><li>A graphical IDE does not exist yet.</li><li>Status will move to a verified state only when a build is published and tested.</li> </ul> <div class=\"callout callout-warn\" style=\"margin-top:1.5rem\"> <h4>Note</h4> <p>Listed for ecosystem completeness and roadmap transparency. No capability is claimed as working in the released toolchain.</p> </div> <p style=\"margin-top:2rem\"><a href=\"/ecosystem\">Back to all components</a> &middot; <a href=\"/transparency\">Verification evidence</a></p> </div> </section>  </main>";
}
fn page_ecosystem_security() -> str {
    return "<main id=\"main\">  <section class=\"section\"> <div class=\"container\"> <p class=\"eyebrow\">Ecosystem component</p> <div style=\"display:flex;align-items:center;gap:0.8rem;flex-wrap:wrap\"> <h1 style=\"margin:0\">Security Capabilities</h1> <span class=\"badge badge-partial\">PARTIALLY VERIFIED</span> </div> <p class=\"lead\" style=\"margin-top:0.8rem\">Memory-safety oriented language design.</p> <p style=\"margin-top:1.5rem\">RUDRA is designed around memory safety. Capability-level security claims on this site are limited to what has been observed and tested by the project team; this is not an independent third-party audit or certification.</p> <h2 style=\"margin-top:2rem\">Details</h2> <ul> <li>Integer division and modulo by zero trap instead of continuing silently.</li><li>List access is bounds-checked, and lists are capped at 512 elements.</li><li>The released ruxc binary is a statically linked ELF with no runtime dependencies.</li><li>Cryptography and TLS 1.3 modules exist in the standard library, with documented limits; certificate authentication is not wired into a live client, so this site does not advertise authenticated HTTPS.</li> </ul> <div class=\"callout callout-warn\" style=\"margin-top:1.5rem\"> <h4>Note</h4> <p>No guarantee is made that the software is free of vulnerabilities.</p> </div> <p style=\"margin-top:2rem\"><a href=\"/ecosystem\">Back to all components</a> &middot; <a href=\"/transparency\">Verification evidence</a></p> </div> </section>  </main>";
}
fn page_ecosystem_standard_library() -> str {
    return "<main id=\"main\">  <section class=\"section\"> <div class=\"container\"> <p class=\"eyebrow\">Ecosystem component</p> <div style=\"display:flex;align-items:center;gap:0.8rem;flex-wrap:wrap\"> <h1 style=\"margin:0\">Standard Library</h1> <span class=\"badge badge-partial\">PARTIALLY VERIFIED</span> </div> <p class=\"lead\" style=\"margin-top:0.8rem\">Standard-library modules for everyday systems work.</p> <p style=\"margin-top:1.5rem\">The 1.1.0 archive ships 68 standard-library modules as .rux source under lib/rudra/std. They are imported with <code>import &quot;module&quot;;</code> and are built with the rudra wrapper, which places them next to your source.</p> <h2 style=\"margin-top:2rem\">Details</h2> <ul> <li>Core: math, fmath, strings, strx, strutil, list, vec, map, set, sort, convert, bits, collections, result.</li><li>I/O and system: io, sysio, bufio, os, time, lines, random, testing.</li><li>Networking: net (sockets), http (request and response helpers, plain TCP to a numeric IP), dns (A-record lookups, IPv4 only) and json (json_get, json_valid and builders).</li><li>Concurrency: chan (FIFO channels) and thread (fork-based processes).</li><li>Cryptography and TLS: sha256, sha512, hmac, hkdf, aes, aesgcm, x25519, p256, ecdsa, x509 and tls13 modules, with documented limits.</li> </ul> <div class=\"callout callout-warn\" style=\"margin-top:1.5rem\"> <h4>Note</h4> <p>Option and Result are not built-in types; result.rux is an ordinary module. json_parse, http_get, spawn, mutex_new and send / recv are not builtins in the self-hosted compiler. TLS is not advertised as authenticated HTTPS.</p> </div> <p style=\"margin-top:2rem\"><a href=\"/ecosystem\">Back to all components</a> &middot; <a href=\"/transparency\">Verification evidence</a></p> </div> </section>  </main>";
}
fn page_ecosystem_toolchain() -> str {
    return "<main id=\"main\">  <section class=\"section\"> <div class=\"container\"> <p class=\"eyebrow\">Ecosystem component</p> <div style=\"display:flex;align-items:center;gap:0.8rem;flex-wrap:wrap\"> <h1 style=\"margin:0\">Developer Toolchain</h1> <span class=\"badge badge-partial\">PARTIALLY VERIFIED</span> </div> <p class=\"lead\" style=\"margin-top:0.8rem\">Compiler, wrapper, and source-repository tooling.</p> <p style=\"margin-top:1.5rem\">The released 1.1.0 toolchain contains two commands: ruxc (the self-hosted compiler) and rudra (a small POSIX shell wrapper that adds the standard library to the build). More tools exist in the source repository and are not yet released.</p> <h2 style=\"margin-top:2rem\">Details</h2> <ul> <li>Released: <code>ruxc &lt;file.rux&gt; &lt;output&gt;</code> and <code>rudra &lt;file.rux&gt; &lt;output&gt;</code>, plus install.sh and uninstall.sh.</li><li>In the source repository, not yet released: a new driver written in RUDRA (rudra build / run / check / vscode-init / toolchain / version).</li><li>In the source repository, not yet released: a language server (lsp/serve.rux) for editors with a built-in LSP client, and a formatter (fmt/fmt.rux) that re-indents code.</li><li>In the source repository, not yet released: a package-manager tool (package-manager/ruxpkg.rux) that verifies a package manifest&#39;s module SHA-256, and a VS Code extension with grammar, snippets and a problem matcher (no JavaScript).</li><li>The released archive has no separate language-server or package-manager binary.</li> </ul> <p style=\"margin-top:2rem\"><a href=\"/ecosystem\">Back to all components</a> &middot; <a href=\"/transparency\">Verification evidence</a></p> </div> </section>  </main>";
}
fn page_features() -> str {
    return "<main id=\"main\">  <section class=\"section\"> <div class=\"container narrow\"> <p class=\"eyebrow\">Product</p> <h1>Features and capabilities</h1> <p class=\"lead\">\nA precise, honest account of what RUDRA does today. Each capability is\n        labeled with a verification status; the evidence behind each is on the\n<a href=\"/transparency\">Transparency</a> page.\n</p> </div> </section> <section class=\"section-tight\"> <div class=\"container\"> <div class=\"grid grid-2\"><div class=\"card\"> <span class=\"badge badge-verified\">VERIFIED</span> <h3 style=\"margin-top:0.5rem\">Compile and run a program</h3> <p style=\"font-size:0.94rem\">The released 1.1.0 compiler, ruxc, builds a .rux source file into a native Linux x86-64 executable, which you then run.</p> <p style=\"font-size:0.84rem;color:var(--text-muted)\"><code>ruxc &lt;file.rux&gt; &lt;output&gt; &amp;&amp; ./output</code></p></div><div class=\"card\"> <span class=\"badge badge-verified\">VERIFIED</span> <h3 style=\"margin-top:0.5rem\">Static zero-dependency compiler</h3> <p style=\"font-size:0.94rem\">ruxc is written in RUDRA and is a statically linked ELF: it has no runtime library dependencies and needs no C compiler, assembler or linker.</p> </div><div class=\"card\"> <span class=\"badge badge-verified\">VERIFIED</span> <h3 style=\"margin-top:0.5rem\">Structs and enums</h3> <p style=\"font-size:0.94rem\">Structs and tagged enums with payload variants, accessed as Shape.Circle(5), with exhaustiveness-checked match.</p> <p style=\"font-size:0.84rem;color:var(--text-muted)\"><code>match s { Shape.Circle(r) =&gt; { ... } }</code></p></div><div class=\"card\"> <span class=\"badge badge-verified\">VERIFIED</span> <h3 style=\"margin-top:0.5rem\">Runtime safety checks</h3> <p style=\"font-size:0.94rem\">Integer division by zero traps, list access is bounds-checked, and lists are capped at 512 elements.</p> </div><div class=\"card\"> <span class=\"badge badge-partial\">PARTIALLY VERIFIED</span> <h3 style=\"margin-top:0.5rem\">Channels (std/chan)</h3> <p style=\"font-size:0.94rem\">A standard-library module, not a builtin: FIFO channels carrying 64-bit integers over an OS pipe, with blocking, non-blocking and timeout receive and explicit status codes. Capacity is finite (about 64 KB by default).</p> <p style=\"font-size:0.84rem;color:var(--text-muted)\"><code>import &quot;chan&quot;; chan_new(); chan_send_status(c, v); chan_recv_status(c, out)</code></p></div><div class=\"card\"> <span class=\"badge badge-partial\">PARTIALLY VERIFIED</span> <h3 style=\"margin-top:0.5rem\">Process concurrency (std/thread)</h3> <p style=\"font-size:0.94rem\">fork-based processes, not shared-memory threads. There are no spawn or mutex builtins and no mutex module in 1.1.0.</p> <p style=\"font-size:0.84rem;color:var(--text-muted)\"><code>thread_fork(); thread_wait()</code></p></div><div class=\"card\"> <span class=\"badge badge-partial\">PARTIALLY VERIFIED</span> <h3 style=\"margin-top:0.5rem\">JSON (std/json)</h3> <p style=\"font-size:0.94rem\">json_get reads a value from a JSON object by key and json_valid checks a document. json_parse does not exist.</p> <p style=\"font-size:0.84rem;color:var(--text-muted)\"><code>import &quot;json&quot;; json_get(doc, key)</code></p></div><div class=\"card\"> <span class=\"badge badge-partial\">PARTIALLY VERIFIED</span> <h3 style=\"margin-top:0.5rem\">HTTP helpers and sockets (std/http, std/net)</h3> <p style=\"font-size:0.94rem\">Request and response builders and parsers plus raw TCP socket calls, for plain HTTP to a numeric IP address. There is no http_get builtin and no HTTPS.</p> <p style=\"font-size:0.84rem;color:var(--text-muted)\"><code>import &quot;http&quot;; http_get_request(host, path)</code></p></div><div class=\"card\"> <span class=\"badge badge-partial\">PARTIALLY VERIFIED</span> <h3 style=\"margin-top:0.5rem\">DNS (std/dns)</h3> <p style=\"font-size:0.94rem\">A-record (IPv4) lookups using the system resolver configuration. AAAA (IPv6) and TCP fallback are not supported.</p> <p style=\"font-size:0.84rem;color:var(--text-muted)\"><code>import &quot;dns&quot;; dns_resolve(host)</code></p></div><div class=\"card\"> <span class=\"badge badge-planned\">PLANNED</span> <h3 style=\"margin-top:0.5rem\">HTTPS / TLS</h3> <p style=\"font-size:0.94rem\">TLS 1.3 and X.509 modules exist in the standard library with documented limits. The encrypted transport works, but certificate authentication is not wired into a live client, so authenticated HTTPS is not available.</p> </div> </div> </div> </section> <section class=\"section-tight\"> <div class=\"container narrow\"> <div class=\"callout callout-warn\"> <h4>Honest scope</h4> <p>\nThe released 1.1.0 toolchain targets Linux x86-64 only. Language features such as traits, closures, tuples, fixed-size arrays and\n          hex or binary literals are not implemented, and generics are erased rather than specialized. Authenticated HTTPS is not available.\n</p> </div> </div> </section>  </main>";
}
